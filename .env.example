# Скопируйте в .env.local (локально) или задайте в Vercel -> Settings -> Environment Variables.
# Проверка значений: npm run check:env

# ── Обязательные: Supabase -> Project Settings -> API ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon / publishable key. Публичный, защищён RLS. НИКОГДА не вставляйте сюда service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Адрес сайта: используется в ссылках из писем (подтверждение email, сброс пароля).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Только для локальных скриптов (seed:demo, e2e). Не задавайте на Vercel, не коммитьте. ──
SUPABASE_SERVICE_ROLE_KEY=
# Пароль демо-аккаунтов для seed:demo (не короче 8 символов). Пусто — будет сгенерирован и напечатан один раз.
DEMO_PASSWORD=
