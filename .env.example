# Скопируйте в .env.local (локально) или задайте в Vercel -> Settings -> Environment Variables.
# Проверка значений: npm run check:env

# ── База данных: Turso (libSQL). turso db create shopflow; turso db show shopflow --url; turso db tokens create shopflow ──
# Для локальной разработки без аккаунта можно использовать файл: file:local.db
TURSO_DATABASE_URL=file:local.db
# Нужен для облачной базы (libsql://…). Секрет: только сервер, не NEXT_PUBLIC_, не коммитить.
TURSO_AUTH_TOKEN=

# ── Загрузка фото в админке: Vercel Blob (Storage -> Blob -> Create). Без токена можно вводить только ссылки на фото. ──
BLOB_READ_WRITE_TOKEN=

# ── Только для локального скрипта seed:demo. Не задавайте на Vercel. ──
# Пароль демо-аккаунтов (не короче 8 символов). Пусто — будет сгенерирован и напечатан один раз.
DEMO_PASSWORD=
